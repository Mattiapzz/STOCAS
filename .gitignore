.claude
# --- CMake / build output ---
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/
Testing/

# --- FetchContent-fetched sources (never commit vendored deps) ---
**/_deps/

# --- Compiled artifacts ---
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Doxygen output ---
docs/generated/

# --- Sanitizer / fuzzer artifacts ---
*.profraw
*.profdata
crash-*
leak-*
oom-*
timeout-*
corpus/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Local presets / cache overrides (keep CMakePresets.json, ignore user overrides) ---
CMakeUserPresets.json

# --- Misc ---
*.log
.env
